# Paths are relative to the working directory. Use absolute paths for scheduled runs.
GROCERY_DATABASE_URL=sqlite:///data/grocery.db
GROCERY_SNAPSHOT_DIR=data/snapshots
GROCERY_HTTP_TIMEOUT_SECONDS=30
GROCERY_USER_AGENT=grocery-agent/0.1 (+replace-with-your-contact)
GROCERY_LOG_LEVEL=INFO

# Kupi aggregates advertised offers from multiple retailers, for the displayed locality.
# Default: all 13 food/drink/baby-food categories. Max pages applies to EACH category.
# Optional: restrict to a single category or provide a JSON list of category slugs.
# GROCERY_KUPI_LISTING_URL=https://www.kupi.cz/slevy/ovoce-a-zelenina
# GROCERY_KUPI_CATEGORY_SLUGS=["maso-drubez-a-ryby","ovoce-a-zelenina"]
GROCERY_KUPI_MAX_PAGES=100
GROCERY_KUPI_REQUEST_DELAY_SECONDS=1
GROCERY_KUPI_ATTEMPTS=3

# One-off scrape → lactose-free protein meal report; paths relative to working directory.
GROCERY_MEAL_CONFIG=config/meals.toml
GROCERY_REPORT_DIR=data/reports
GROCERY_LOCK_PATH=data/workflow.lock

# Independent catalogue collector; these settings do not start a process or timer.
GROCERY_COLLECTOR_CONFIG=config/collector.toml
GROCERY_COLLECTOR_DAILY_AT=02:00
GROCERY_COLLECTOR_TIMEZONE=Europe/Prague
GROCERY_COLLECTOR_RUN_ON_STARTUP=true
# GROCERY_COLLECTOR_SOURCES=["kupi"]
GROCERY_CATALOGUE_MAX_AGE_HOURS=36
GROCERY_CATALOGUE_TIMEZONE=Europe/Prague
GROCERY_CATALOGUE_ALLOW_CACHED_ON_FAILURE=true
# Docker publishes the private catalogue API on loopback only.
GROCERY_CATALOGUE_PORT=8000

# Optional user/profile database: only `db ... control` opens it in phase 1.
# Normal CLI acquisition, catalogue and meal commands never use this database.
# GROCERY_CONTROL_DATABASE_URL=sqlite:///data/control.db

# Rohlík: public anonymous online catalog (eleven food/drink categories by default).
# Optional: focus on meat, produce and cupboard staples using a JSON list of category IDs.
# GROCERY_ROHLIK_CATEGORY_IDS=[300103000,300102000,300106000]
GROCERY_ROHLIK_PAGE_SIZE=100
GROCERY_ROHLIK_MAX_PAGES=100
GROCERY_ROHLIK_REQUEST_DELAY_SECONDS=1
GROCERY_ROHLIK_ATTEMPTS=3
# Checks the displayed public warehouse; does not select a delivery address/warehouse.
# GROCERY_ROHLIK_EXPECTED_WAREHOUSE_ID=8791

# Tesco: all ordinary online catalog departments, acquired in an isolated browser.
# Requires the browser extra and Chromium; visible mode needs a graphical session.
# GROCERY_TESCO_CATEGORY_SLUGS=["maso-a-lahudky","ovoce-a-zelenina","trvanlive"]
GROCERY_TESCO_MAX_PAGES=500
GROCERY_TESCO_REQUEST_DELAY_SECONDS=1
GROCERY_TESCO_ATTEMPTS=3
GROCERY_TESCO_BROWSER_HEADLESS=false
GROCERY_TESCO_NAVIGATION_TIMEOUT_MS=30000
# GROCERY_TESCO_BROWSER_EXECUTABLE=/usr/bin/chromium

# Makro: customer login and selected branch assortment, prices including VAT.
# First run: .venv/bin/python -m grocery_agent.stores.makro.login
GROCERY_MAKRO_SESSION_PATH=data/makro/session.json
GROCERY_MAKRO_ACCOUNT_SCOPE=local
# GROCERY_MAKRO_STORE_NAME=makro Praha - Stodůlky
# GROCERY_MAKRO_CATEGORY_PATHS=["potraviny"]
GROCERY_MAKRO_MAX_PAGES=1000
GROCERY_MAKRO_REQUEST_DELAY_SECONDS=1
GROCERY_MAKRO_BROWSER_HEADLESS=true
GROCERY_MAKRO_NAVIGATION_TIMEOUT_MS=45000
# GROCERY_MAKRO_BROWSER_EXECUTABLE=/usr/bin/chromium
